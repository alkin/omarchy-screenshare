{
  "manifest_version": 3,
  "name": "Omarchy Screen Share Indicator",
  "version": "1.1.0",
  "description": "Tells the Omarchy bar when a page is sharing your screen, a window or a tab. Installed by the io.github.alkin.screenshare plugin.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
